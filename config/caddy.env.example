# Caddy-only public edge settings. Install path:
# /opt/gp-cloud/config/caddy.env (root:caddy, mode 0640)
# GP_CLOUD_PREVIEW_DOMAIN and GP_CLOUD_CONTROL_PORT must match gp-cloud.env.
GP_CLOUD_PREVIEW_DOMAIN=preview.example.com
GP_CLOUD_CONTROL_PORT=8787
GP_CLOUD_CADDY_ACME_EMAIL=
# Supported providers: cloudflare or godaddy. For GoDaddy, use API key:secret.
GP_CLOUD_DNS_PROVIDER=cloudflare
GP_CLOUD_DNS_CREDENTIAL=
