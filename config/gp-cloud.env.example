# Project name: GP Cloud Preview
# Public preview suffix. Example: preview.example.com
# Replace this with a domain that you control and point at the public edge.
GP_CLOUD_PREVIEW_DOMAIN=preview.example.com
# Caddy's plain-HTTP listener. Port 80 gives a normal URL without a suffix,
# but it does not provide encryption. Use an external TLS proxy for production.
GP_CLOUD_HTTP_PORT=80
GP_CLOUD_PUBLIC_SCHEME=http
# Set true when the browser reaches the UI through HTTPS.
GP_CLOUD_COOKIE_SECURE=false

# API and webhook authentication. Generate with: openssl rand -hex 32
GP_CLOUD_API_TOKEN=
GP_CLOUD_GITHUB_WEBHOOK_SECRET=
GP_CLOUD_CONTROL_PORT=8787
# Port listened to inside generated preview containers. Host ports remain
# dynamically allocated on loopback; the public URL is still HTTPS via Caddy.
GP_CLOUD_DEFAULT_APP_PORT=2222
# UI password. If blank, the API token is accepted for the initial login.
GP_CLOUD_ADMIN_PASSWORD=

# Comma-separated GitHub repositories, e.g. owner/my-app. Empty means deny all.
GP_CLOUD_ALLOWED_REPOS=
GP_CLOUD_ALLOW_FORKS=false

# Optional GitHub App access for private repository cloning.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# Default application runtime limits.
GP_CLOUD_CPU_LIMIT=1.0
GP_CLOUD_MEMORY_LIMIT=768m
GP_CLOUD_BUILD_TIMEOUT_SECONDS=600
GP_CLOUD_STARTUP_TIMEOUT_SECONDS=60
GP_CLOUD_HEALTH_TIMEOUT_SECONDS=60

# Public preview cleanup. Zero disables TTL (PR close cleanup still applies).
GP_CLOUD_DEPLOYMENT_TTL_SECONDS=86400
GP_CLOUD_MAX_DEPLOYMENT_TTL_SECONDS=604800

# HashiCorp Vault KV v2. The control plane never persists runtime secret values.
GP_CLOUD_VAULT_ADDR=
GP_CLOUD_VAULT_TOKEN=
GP_CLOUD_VAULT_TOKEN_FILE=
GP_CLOUD_VAULT_MOUNT=secret
GP_CLOUD_VAULT_PATH_PREFIX=gp-cloud/

# Debug only: retain checked-out/materialized build workspaces under
# /opt/gp-cloud/deployments/<slug>/source after a build. Keep false on a
# constrained VM; logs and metadata are retained regardless.
GP_CLOUD_RETAIN_WORKSPACES=false
