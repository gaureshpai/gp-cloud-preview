{
	# Routes are generated by the trusted host-side worker. Caddy remains the
	# only public entry point for preview applications.
	http_port {$GP_CLOUD_HTTP_PORT}
}

http://control.{$GP_CLOUD_PREVIEW_DOMAIN}:{$GP_CLOUD_HTTP_PORT} {
	reverse_proxy 127.0.0.1:{$GP_CLOUD_CONTROL_PORT}
}

# Also make the control dashboard reachable by the VM's public IPv4 address.
# More specific preview host routes imported below take precedence for preview
# domains; arbitrary hosts still reach only the authenticated control UI.
:{$GP_CLOUD_HTTP_PORT} {
	reverse_proxy 127.0.0.1:{$GP_CLOUD_CONTROL_PORT}
}

import /opt/gp-cloud/config/caddy/routes/*.caddy
