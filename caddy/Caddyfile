{
	email {$GP_CLOUD_CADDY_ACME_EMAIL}
}

# Public mode requires a Caddy build containing github.com/caddy-dns/cloudflare.
# One DNS-01 wildcard certificate covers previews and the two narrow ingress
# hosts. The token belongs only in Caddy's root-owned environment file.
https://*.{$GP_CLOUD_PREVIEW_DOMAIN} {
	tls {
		dns cloudflare {$GP_CLOUD_CLOUDFLARE_API_TOKEN}
	}

	@webhook_host host webhook.{$GP_CLOUD_PREVIEW_DOMAIN}
	handle @webhook_host {
		@github_webhook {
			method POST
			path /webhooks/github
		}
		handle @github_webhook {
			reverse_proxy 127.0.0.1:{$GP_CLOUD_CONTROL_PORT} {
				header_up X-GP-Client-IP {remote_host}
			}
		}
		respond 404
	}

	@actions_host host actions.{$GP_CLOUD_PREVIEW_DOMAIN}
	handle @actions_host {
		@github_action path /actions/gp-cloud-deploy /actions/gp-cloud-deploy/*
		handle @github_action {
			reverse_proxy 127.0.0.1:{$GP_CLOUD_CONTROL_PORT} {
				header_up X-GP-Client-IP {remote_host}
			}
		}
		respond 404
	}

	@control_host host control.{$GP_CLOUD_PREVIEW_DOMAIN}
	handle @control_host {
		@dashboard path / /ui /ui/*
		handle @dashboard {
			reverse_proxy 127.0.0.1:{$GP_CLOUD_CONTROL_PORT} {
				header_up X-GP-Client-IP {remote_host}
			}
		}
		respond 404
	}

	# Files contain only trusted host matchers and loopback upstream ports.
	import /opt/gp-cloud/config/caddy/routes/*.caddy
	respond 404
}

http://*.{$GP_CLOUD_PREVIEW_DOMAIN} {
	redir https://{host}{uri} permanent
}
