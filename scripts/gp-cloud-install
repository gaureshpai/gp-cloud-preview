#!/usr/bin/env bash
# Idempotently copy the audited control plane into /opt/gp-cloud and configure
# Caddy/systemd. This script never generates credentials.
set -Eeuo pipefail

ENABLE_PUBLIC_EDGE=0
DISABLE_PUBLIC_EDGE=0
ENABLE_MONITORING=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --enable-public-edge) ENABLE_PUBLIC_EDGE=1 ;;
    --disable-public-edge) DISABLE_PUBLIC_EDGE=1 ;;
    --enable-monitoring) ENABLE_MONITORING=1 ;;
    *) echo "Usage: $0 [--enable-public-edge|--disable-public-edge] [--enable-monitoring]" >&2; exit 2 ;;
  esac
  shift
done
if [[ "$ENABLE_PUBLIC_EDGE" == "1" && "$DISABLE_PUBLIC_EDGE" == "1" ]]; then
  echo "choose only one public-edge action" >&2
  exit 2
fi

# Install GP Cloud Preview on a Debian/Ubuntu host. Run as root from this
# checkout, then edit /opt/gp-cloud/config/gp-cloud.env before starting it.
[[ "${EUID}" -eq 0 ]] || { echo "run as root" >&2; exit 1; }

SOURCE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
INSTALL_ROOT=/opt/gp-cloud
CONFIG_ROOT="$INSTALL_ROOT/config"

for command_name in python3 docker git curl caddy systemctl realpath; do
  command -v "$command_name" >/dev/null || { echo "missing prerequisite: $command_name" >&2; exit 1; }
done
docker buildx version >/dev/null || { echo "missing prerequisite: docker buildx" >&2; exit 1; }

install -d -m 0750 "$INSTALL_ROOT" "$INSTALL_ROOT/control" "$INSTALL_ROOT/worker" \
  "$INSTALL_ROOT/monitoring" \
  "$INSTALL_ROOT/config/caddy/routes" "$INSTALL_ROOT/config/monitoring" \
  "$INSTALL_ROOT/data/deployments" "$INSTALL_ROOT/data/queue" "$INSTALL_ROOT/data/action-tokens" \
  "$INSTALL_ROOT/deployments" "$INSTALL_ROOT/logs"
# Caddy must be able to traverse only the route path. It does not receive
# access to deployment data, logs, or the control service's secret files.
chgrp caddy "$INSTALL_ROOT" "$CONFIG_ROOT" "$CONFIG_ROOT/caddy" "$CONFIG_ROOT/caddy/routes"
chmod 0750 "$INSTALL_ROOT" "$CONFIG_ROOT" "$CONFIG_ROOT/caddy"
chmod 2750 "$CONFIG_ROOT/caddy/routes"
for route_file in "$CONFIG_ROOT"/caddy/routes/*.caddy; do
  [[ -e "$route_file" ]] || continue
  chown root:caddy "$route_file"
  chmod 0640 "$route_file"
done
install -m 0750 "$SOURCE_ROOT/control/gp_cloud_control.py" "$INSTALL_ROOT/control/"
install -m 0750 "$SOURCE_ROOT/scripts/gp-cloud-deploy" "$INSTALL_ROOT/worker/"
install -m 0750 "$SOURCE_ROOT/scripts/gp-cloud-clean" "$INSTALL_ROOT/worker/"
install -m 0750 "$SOURCE_ROOT/scripts/gp-cloud-inspect" "$INSTALL_ROOT/worker/"
install -m 0750 "$SOURCE_ROOT/scripts/gp-cloud-monitoring" "$INSTALL_ROOT/worker/"
install -m 0644 "$SOURCE_ROOT/monitoring/prometheus.yml" "$INSTALL_ROOT/monitoring/"
install -m 0644 "$SOURCE_ROOT/monitoring/alerts.yml" "$INSTALL_ROOT/monitoring/"
install -m 0644 "$SOURCE_ROOT/monitoring/gp-cloud-prometheus.service" "$INSTALL_ROOT/monitoring/"
install -m 0644 "$SOURCE_ROOT/control/gp-cloud.service" /etc/systemd/system/gp-cloud.service

if [[ ! -f "$CONFIG_ROOT/gp-cloud.env" ]]; then
  install -m 0600 "$SOURCE_ROOT/config/gp-cloud.env.example" "$CONFIG_ROOT/gp-cloud.env"
  echo "created $CONFIG_ROOT/gp-cloud.env; edit it before starting gp-cloud" >&2
fi
chown root:root "$CONFIG_ROOT/gp-cloud.env"
chmod 0600 "$CONFIG_ROOT/gp-cloud.env"
if [[ ! -f "$CONFIG_ROOT/caddy.env" ]]; then
  install -o root -g caddy -m 0640 "$SOURCE_ROOT/config/caddy.env.example" "$CONFIG_ROOT/caddy.env"
fi

systemctl daemon-reload
read_config_value() {
  local name=$1 file=$2 value
  value=$(sed -nE "s/^${name}=//p" "$file" | tail -1)
  value=${value#\"}; value=${value%\"}
  value=${value#\'}; value=${value%\'}
  printf '%s' "$value"
}
systemctl enable gp-cloud.service
if [[ "$ENABLE_PUBLIC_EDGE" == "1" ]]; then
  GP_CLOUD_PREVIEW_DOMAIN=$(read_config_value GP_CLOUD_PREVIEW_DOMAIN "$CONFIG_ROOT/caddy.env")
  GP_CLOUD_CONTROL_PORT=$(read_config_value GP_CLOUD_CONTROL_PORT "$CONFIG_ROOT/caddy.env")
  GP_CLOUD_CADDY_ACME_EMAIL=$(read_config_value GP_CLOUD_CADDY_ACME_EMAIL "$CONFIG_ROOT/caddy.env")
  GP_CLOUD_CLOUDFLARE_API_TOKEN=$(read_config_value GP_CLOUD_CLOUDFLARE_API_TOKEN "$CONFIG_ROOT/caddy.env")
  GP_CLOUD_PUBLIC_SCHEME=$(read_config_value GP_CLOUD_PUBLIC_SCHEME "$CONFIG_ROOT/gp-cloud.env")
  GP_CLOUD_COOKIE_SECURE=$(read_config_value GP_CLOUD_COOKIE_SECURE "$CONFIG_ROOT/gp-cloud.env")
  export GP_CLOUD_PREVIEW_DOMAIN GP_CLOUD_CONTROL_PORT GP_CLOUD_CADDY_ACME_EMAIL
  export GP_CLOUD_CLOUDFLARE_API_TOKEN
  : "${GP_CLOUD_PREVIEW_DOMAIN:?configure GP_CLOUD_PREVIEW_DOMAIN before enabling the edge}"
  : "${GP_CLOUD_CADDY_ACME_EMAIL:?configure GP_CLOUD_CADDY_ACME_EMAIL before enabling the edge}"
  : "${GP_CLOUD_CLOUDFLARE_API_TOKEN:?configure GP_CLOUD_CLOUDFLARE_API_TOKEN before enabling the edge}"
  [[ "${GP_CLOUD_PUBLIC_SCHEME:-}" == "https" && "${GP_CLOUD_COOKIE_SECURE:-}" == "true" ]] || {
    echo "public edge requires GP_CLOUD_PUBLIC_SCHEME=https and GP_CLOUD_COOKIE_SECURE=true" >&2
    exit 1
  }
  caddy list-modules | grep -qx 'dns.providers.cloudflare' || {
    echo "Caddy requires the caddy-dns/cloudflare module for wildcard DNS-01" >&2
    exit 1
  }
  caddy validate --config "$SOURCE_ROOT/caddy/Caddyfile"
  CADDY_BACKUP=""
  if [[ -f /etc/caddy/Caddyfile ]] && ! cmp -s "$SOURCE_ROOT/caddy/Caddyfile" /etc/caddy/Caddyfile; then
    CADDY_BACKUP="/etc/caddy/Caddyfile.gp-cloud-backup.$(date +%s)"
    cp -a /etc/caddy/Caddyfile "$CADDY_BACKUP"
  fi
  install -o root -g caddy -m 0640 "$SOURCE_ROOT/caddy/Caddyfile" /etc/caddy/Caddyfile
  mkdir -p /etc/systemd/system/caddy.service.d
  install -m 0644 "$SOURCE_ROOT/caddy/gp-cloud-env.conf" /etc/systemd/system/caddy.service.d/gp-cloud-env.conf
  chown root:caddy "$CONFIG_ROOT/caddy.env"
  chmod 0640 "$CONFIG_ROOT/caddy.env"
  if ! caddy validate --config /etc/caddy/Caddyfile; then
    if [[ -n "$CADDY_BACKUP" ]]; then
      install -o root -g caddy -m 0640 "$CADDY_BACKUP" /etc/caddy/Caddyfile
    else
      rm -f /etc/caddy/Caddyfile
    fi
    echo "installed Caddyfile failed validation; previous configuration restored" >&2
    exit 1
  fi
  install -o root -g root -m 0644 /dev/null /etc/caddy/.gp-cloud-preview-managed
  # The drop-in is installed after the initial daemon-reload above. Reload the
  # unit definitions, then apply the new Caddyfile immediately: enable alone
  # does not start a stopped service or refresh a running one.
  systemctl daemon-reload
  systemctl enable caddy.service
  if systemctl is-active --quiet caddy.service; then
    systemctl reload caddy.service
  else
    systemctl start caddy.service
  fi
elif [[ "$DISABLE_PUBLIC_EDGE" == "1" ]]; then
  [[ -f /etc/caddy/.gp-cloud-preview-managed ]] || {
    echo "refusing to disable a Caddy service not marked as GP Cloud-managed" >&2
    exit 1
  }
  systemctl disable --now caddy.service
  rm -f /etc/caddy/.gp-cloud-preview-managed
fi
if [[ "$ENABLE_MONITORING" == "1" ]]; then
  "$SOURCE_ROOT/scripts/gp-cloud-monitoring" enable
fi
echo "Installation complete. Configure $CONFIG_ROOT/gp-cloud.env, then run:"
echo "  systemctl restart gp-cloud.service"
echo "Public HTTPS and monitoring remain disabled unless their explicit flags were used."
